{
    "cmd": ["g++", "-std=c++17", "-O2", "${file}", "-o", "${file_base_name}"],
    "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "working_dir": "${file_path}",
    "selector": "source.c++",

    "variants":
    [
        {
            "name": "Run",
            "cmd": ["bash", "-c", "g++ -std=c++17 -O2 '${file}' -o '${file_base_name}' && ./'${file_base_name}'"]
        }
    ]
}